# ==============================================================================
# Visatrip Global — Environment Variables Reference (.env.example)
# Copy to .env and fill with real production secrets. NEVER commit .env to Git.
# ==============================================================================

# --- Runtime & Server ---
NODE_ENV="production"
PORT="3000"
# Set to "true" in production if Express (instead of CDN/Nginx) should 301 redirect apex -> www
ENFORCE_WWW_REDIRECT="false"
# Set to "true" to disable Vite HMR watcher in restricted environments
DISABLE_HMR="false"

# --- Canonical Site URL & Public Contact Overrides ---
# Used by server.ts for canonical URLs, sitemap.xml, robots.txt, and Open Graph image URLs
APP_URL="https://www.visatripglobal.com"
# Client-side mirror of APP_URL (baked at `npm run build` time)
VITE_SITE_URL="https://www.visatripglobal.com"
# International WhatsApp number without "+" or spaces (used for wa.me click-to-chat links)
VITE_WHATSAPP_NUMBER="8801771304219"

# --- GitHub Pages / Static Hosting Overrides (Optional) ---
# Base URL path: "/" for custom domain or user-site; "/<repo-name>/" for GitHub Pages project site
VITE_BASE_PATH="/"
# Set "true" for static-only hosting (GitHub Pages) where no Express /api/* backend runs on the same origin
VITE_STATIC_SITE="false"
# Optional external Express backend URL (e.g. https://api.visatripglobal.com) if hosting API separately
VITE_API_BASE_URL=""
# Optional static form endpoint (e.g. Formspree or Web3Forms URL) to capture leads on GitHub Pages alongside WhatsApp
VITE_FORM_ENDPOINT=""

# --- Analytics & Search Console Verification (Optional — leave empty to disable) ---
# Loaded ONLY after explicit visitor cookie consent (lazyOnload)
VITE_GA4_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""
# Google Search Console HTML meta tag verification token (alternative to DNS TXT verification)
VITE_GSC_VERIFICATION=""

# --- Admin Leads Dashboard & On-Demand ISR Revalidation ---
# Protects /admin/leads, /api/leads, and /api/revalidate. MUST be a strong random passphrase in production.
ADMIN_PASSWORD="change-this-secure-password"

# --- Lead Email Alerts — Option A: Resend HTTP API (Recommended) ---
RESEND_API_KEY=""
EMAIL_FROM="Visatrip Global <noreply@visatripglobal.com>"
EMAIL_TO="info@visatripglobal.com"

# --- Lead Email Alerts — Option B: SMTP via Nodemailer (Fallback if RESEND_API_KEY is empty) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Set "true" for implicit TLS on port 465; "false" for STARTTLS on port 587
SMTP_SECURE="false"
